# Use a very light Python image for the UI
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

# Only install basic web dependencies
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copy only requirements and install (Skipping Torch/ML libraries)
COPY requirements.txt .
RUN pip install --no-cache-dir django daphne django-cors-headers djangorestframework requests httpx redis

# Copy source
COPY . .

# Default command
CMD ["python", "microservices/web_ui/manage.py", "runserver", "0.0.0.0:8003"]
